                                </Grid>
                            </Viewbox>
                        </Button>

                        <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
                            <TextBlock Text="Session completed"
                                       Foreground="#1A1A1A"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="Notes have been generated"
                                       Foreground="#757575"
                                       FontSize="12"
                                       FontWeight="Regular"
                                       Margin="0,1,0,0"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Button Grid.Column="3"
                                Style="{StaticResource ProcessedViewButtonStyle}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0"
                                Command="{Binding ViewCommand}">
                            <Grid VerticalAlignment="Center" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="View"
                                           Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                           FontSize="14"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />
                                <Path Grid.Column="1"
                                      Data="M 1,1 L 5,4 L 1,7"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.6"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      Margin="6,2,0,0"
                                      Width="6"
                                      Height="8"
                                      Stretch="Fill"
                                      VerticalAlignment="Center" />
                            </Grid>
                        </Button>
                    </Grid>

                    <ProgressBar Grid.Row="1"
                                 Panel.ZIndex="1"
                                 Minimum="0"
                                 Maximum="100"
                                 Value="{Binding ProgressPercent, Mode=OneWay}"
                                 Margin="0"
                                 Padding="0"
                                 VerticalAlignment="Bottom"
                                 Height="3"
                                 Background="#EFEFF5"
                                 Foreground="#215FFF"
                                 Style="{StaticResource OverlayProgressStyle}" />
                </Grid>
            </Border>
            <Button Style="{StaticResource OverlayCloseButtonStyle}"
                    Click="CloseOverlayButton_Click"
                    ToolTip="Dismiss overlay"
                    AutomationProperties.AutomationId="{Binding TransactionAutomationId}">
                <Viewbox Width="8" Height="8" Stretch="Fill">
                    <Path Data="M 1,1 L 7,7 M 7,1 L 1,7"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="1.5"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          SnapsToDevicePixels="True" />
                </Viewbox>
            </Button>
        </Grid>
    </Grid>
</Window>
