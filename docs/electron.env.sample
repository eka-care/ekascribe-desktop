# electron.env.sample
#
# Copy this file to `electron.env` in the project root and fill in real values.
# Obtain the actual credentials from any existing team member.
# This file is a template only — never commit real keys to the repo.

# Application environment
# Values: PROD | DEV
NEXT_PUBLIC_ENV=PROD

# Mixpanel analytics project token
# Used by ekascribe-web for product analytics events
NEXT_PUBLIC_MIX_PANEL_KEY=YOUR_MIXPANEL_TOKEN

# Crisp customer chat widget site ID
# Used by ekascribe-web to embed the Crisp support chat
NEXT_PUBLIC_CRISP_WEBSITE_ID=YOUR_CRISP_WEBSITE_ID

# New Relic license key for log forwarding
# Used by logManager to ship logs to New Relic Logs API
NEW_RELIC_LICENSE_KEY=YOUR_NEW_RELIC_LICENSE_KEY

